---
import projects from '../data/projects.json';

export function getStaticPaths() {
  return projects
    .filter((p) => Boolean(p.legacySlug))
    .map((project) => ({
      params: { legacySlug: project.legacySlug! },
      props: { targetUrl: `/work/${project.id}` },
    }));
}

const { targetUrl } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0;url=${targetUrl}`} />
    <link rel="canonical" href={targetUrl} />
    <title>Redirecting to {targetUrl}</title>
  </head>
  <body class="bg-neutral-950 text-neutral-200 flex items-center justify-center min-h-screen font-sans">
    <p class="text-xs uppercase tracking-widest">
      Redirecting to <a href={targetUrl} class="underline">{targetUrl}</a>...
    </p>
  </body>
</html>
