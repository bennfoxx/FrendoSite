---
import site from '../data/site.json';

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 w-full bg-black text-white transition-colors duration-300">
  <div class="w-full px-[2.73vw] min-h-[82px] lg:min-h-[104px] grid grid-cols-1 lg:grid-cols-[3fr_1fr] items-center gap-5">
    <!-- Left 3fr Area: Brand Name + Role + Horizontal Menu -->
    <div class="flex items-center justify-between lg:justify-start w-full gap-6">
      <div class="flex flex-col sm:flex-row sm:items-baseline gap-2 sm:gap-8 lg:gap-12">
        <a
          href="/"
          class="font-display font-bold text-[20px] sm:text-[22px] lg:text-[24px] leading-none tracking-normal text-white uppercase hover:opacity-85 transition"
        >
          {site.name}
        </a>
        <span class="font-display font-normal text-[14px] sm:text-[16px] lg:text-[18px] leading-none tracking-normal text-white uppercase">
          {site.role}
        </span>
      </div>

      <!-- Desktop Horizontal Menu (aligned to right of 3fr column, matching christopherfrendo.com) -->
      <nav aria-label="Main navigation" class="hidden md:flex items-center gap-1 ml-auto">
        {site.navigation.map((item) => {
          const isActive =
            item.href === '/'
              ? currentPath === '/' || currentPath.startsWith('/work/') || ['/gosmokeless', '/bluntmarketing', '/valottery'].includes(currentPath)
              : currentPath.startsWith(item.href);
          return (
            <a
              href={item.href}
              class:list={[
                'font-menu text-[16px] leading-[1.4em] px-4 py-3 border-t-2 transition-colors',
                isActive
                  ? 'text-white border-white'
                  : 'text-white/85 border-transparent hover:text-white hover:border-white/70',
              ]}
            >
              {item.label}
            </a>
          );
        })}
      </nav>

      <!-- Mobile Hamburger Trigger -->
      <button
        id="mobile-menu-open"
        type="button"
        aria-label="Open navigation menu"
        aria-expanded="false"
        class="md:hidden inline-flex items-center justify-center p-2 text-white hover:opacity-80 transition"
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Right 1fr Area: Social Icons Bar -->
    <div class="hidden lg:flex items-center justify-center lg:justify-end gap-4">
      <!-- Instagram -->
      <a
        href="https://www.instagram.com/frendonics/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Instagram"
        class="text-white hover:opacity-75 transition"
      >
        <svg class="w-[22px] h-[22px]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
        </svg>
      </a>
      <!-- LinkedIn -->
      <a
        href="https://www.linkedin.com/in/christopher-frendo-55033610/"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="text-white hover:opacity-75 transition"
      >
        <svg class="w-[22px] h-[22px]" fill="currentColor" viewBox="0 0 24 24">
          <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z"/>
        </svg>
      </a>
    </div>
  </div>

  <!-- Mobile Slide-Over Drawer -->
  <div
    id="mobile-menu-drawer"
    class="fixed inset-0 z-50 bg-black/95 backdrop-blur-md hidden flex-col justify-between p-6 md:hidden"
    aria-hidden="true"
  >
    <div class="flex items-center justify-between pb-5 border-b border-white/20">
      <div>
        <span class="font-display text-lg font-bold text-white uppercase block">
          {site.name}
        </span>
        <span class="font-display text-xs uppercase text-white/75">
          {site.role}
        </span>
      </div>
      <button
        id="mobile-menu-close"
        type="button"
        aria-label="Close navigation menu"
        class="inline-flex items-center justify-center p-2 text-white"
      >
        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <nav class="flex flex-col gap-6 my-auto py-8">
      {site.navigation.map((item) => (
        <a
          href={item.href}
          class="font-menu text-2xl text-white hover:opacity-75 transition"
        >
          {item.label}
        </a>
      ))}
      <a
        href="/#contact"
        class="font-menu text-2xl text-white/80 hover:text-white transition pt-4 border-t border-white/20"
      >
        Contact
      </a>
    </nav>

    <div class="flex flex-wrap gap-6 pt-6 border-t border-white/20">
      {site.socials.slice(0, 2).map((social) => (
        <a
          href={social.href}
          target="_blank"
          rel="noopener noreferrer"
          class="font-menu text-sm text-white/80 hover:text-white transition"
        >
          {social.label}
        </a>
      ))}
    </div>
  </div>
</header>

<script>
  const openBtn = document.getElementById('mobile-menu-open');
  const closeBtn = document.getElementById('mobile-menu-close');
  const drawer = document.getElementById('mobile-menu-drawer');

  function toggleMenu(show: boolean) {
    if (!drawer || !openBtn) return;
    if (show) {
      drawer.classList.remove('hidden');
      drawer.classList.add('flex');
      drawer.setAttribute('aria-hidden', 'false');
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    } else {
      drawer.classList.add('hidden');
      drawer.classList.remove('flex');
      drawer.setAttribute('aria-hidden', 'true');
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }
  }

  openBtn?.addEventListener('click', () => toggleMenu(true));
  closeBtn?.addEventListener('click', () => toggleMenu(false));
  drawer?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => toggleMenu(false));
  });
</script>
